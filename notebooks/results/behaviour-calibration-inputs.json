        "sql": "WITH periods AS (\n SELECT transaction_hash,node_id,start_time,end_time,duration_days,stake_navax\n FROM read_parquet(?)\n WHERE role='validator' AND accepted_at < TIMESTAMP '2025-11-19 16:00:00'\n), paired AS (\n SELECT *, lead(start_time) OVER (PARTITION BY node_id ORDER BY start_time,transaction_hash) AS next_start\n FROM periods\n)\nSELECT count(*) AS eligible_ends,\n count(*) FILTER (WHERE next_start BETWEEN end_time AND end_time+INTERVAL '7 days') AS renewed_ends,\n sum(stake_navax::HUGEINT) AS eligible_stake_navax,\n coalesce(sum(stake_navax::HUGEINT) FILTER (WHERE next_start BETWEEN end_time AND end_time+INTERVAL '7 days'),0) AS renewed_stake_navax\nFROM paired WHERE end_time+INTERVAL '7 days' < TIMESTAMP '2025-11-19 16:00:00'\n AND (next_start IS NULL OR next_start>=end_time)\n",
        "text": "Same-node renewal within seven days among nonoverlapping validator endings whose entire seven-day follow-up finishes before the development cutoff."
