{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonding-curves/avalanche-phase-ii-research/data/data-catalog.schema.json",
  "title": "Avalanche research data catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "sources",
    "datasets"
  ],
  "properties": {
    "$schema": {
      "const": "data-catalog.schema.json"
    },
    "schema_version": {
      "const": "avalanche-data-catalog/v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rest_api_source"
          },
          {
            "$ref": "#/$defs/database_share_source"
          },
          {
            "$ref": "#/$defs/derived_source"
          }
        ]
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_id",
          "status",
          "description",
          "fields"
        ],
        "oneOf": [
          {
            "required": [
              "endpoint_ids"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "query_ids"
                  ]
                },
                {
                  "required": [
                    "input_ids"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "query_ids"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "endpoint_ids"
                  ]
                },
                {
                  "required": [
                    "input_ids"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "input_ids"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "endpoint_ids"
                  ]
                },
                {
                  "required": [
                    "query_ids"
                  ]
                }
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "declared",
              "implemented",
              "blocked",
              "stale"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "contract_quantities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "validator flows",
                "delegator flows",
                "rewards",
                "durations",
                "context"
              ]
            },
            "uniqueItems": true
          },
          "studies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "endpoint_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "unit",
                "derivation"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]+$"
                },
                "type": {
                  "enum": [
                    "integer",
                    "number",
                    "boolean",
                    "timestamp",
                    "string"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "derivation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "input_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "source_properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "declared",
          "implemented",
          "blocked",
          "stale"
        ]
      },
      "authority": {
        "type": "string",
        "minLength": 1
      },
      "documentation_url": {
        "type": "string",
        "format": "uri"
      },
      "authentication": {
        "type": "string",
        "minLength": 1
      },
      "reuse_status": {
        "type": "string",
        "minLength": 1
      }
    },
    "rest_api_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_type",
        "status",
        "authority",
        "documentation_url",
        "authentication",
        "reuse_status",
        "endpoints"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_properties/id"
        },
        "name": {
          "$ref": "#/$defs/source_properties/name"
        },
        "source_type": {
          "const": "rest_api"
        },
        "status": {
          "$ref": "#/$defs/source_properties/status"
        },
        "authority": {
          "$ref": "#/$defs/source_properties/authority"
        },
        "documentation_url": {
          "$ref": "#/$defs/source_properties/documentation_url"
        },
        "authentication": {
          "$ref": "#/$defs/source_properties/authentication"
        },
        "reuse_status": {
          "$ref": "#/$defs/source_properties/reuse_status"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "response_fields"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "request_json": {
                "type": "object",
                "description": "JSON body; its presence makes the request a POST"
              },
              "content": {
                "enum": [
                  "json",
                  "xml"
                ],
                "description": "response body type; json when absent"
              },
              "response_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "page": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token_field",
                  "token_parameter"
                ],
                "description": "follow a continuation token: the response field that carries it and the query parameter that sends it; each page becomes one JSON line of the raw file",
                "properties": {
                  "token_field": {
                    "type": "string"
                  },
                  "token_parameter": {
                    "type": "string"
                  },
                  "max_pages": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "first_pages": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "end the walk cleanly after this many pages: a sweep of the newest rows of an endpoint that lists newest first"
                  }
                }
              }
            }
          }
        },
        "observed_site_cross_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "stability",
            "relations"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "stability": {
              "type": "string",
              "minLength": 1
            },
            "relations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "database_share_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_type",
        "status",
        "authority",
        "documentation_url",
        "authentication",
        "reuse_status",
        "database",
        "schema",
        "queries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_properties/id"
        },
        "name": {
          "$ref": "#/$defs/source_properties/name"
        },
        "source_type": {
          "const": "database_share"
        },
        "status": {
          "$ref": "#/$defs/source_properties/status"
        },
        "authority": {
          "$ref": "#/$defs/source_properties/authority"
        },
        "documentation_url": {
          "$ref": "#/$defs/source_properties/documentation_url"
        },
        "authentication": {
          "$ref": "#/$defs/source_properties/authentication"
        },
        "reuse_status": {
          "$ref": "#/$defs/source_properties/reuse_status"
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sql",
              "relations",
              "parameters",
              "observed_semantics"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "sql": {
                "type": "string",
                "pattern": "^queries/[a-z][a-z0-9-]+\\.sql$"
              },
              "relations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "uniqueItems": true
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "default",
                    "meaning"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "type": {
                      "enum": [
                        "date"
                      ]
                    },
                    "default": {
                      "type": "string",
                      "minLength": 1
                    },
                    "meaning": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "observed_semantics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "derived_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_type",
        "status",
        "authority",
        "documentation_url",
        "authentication",
        "reuse_status",
        "inputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_properties/id"
        },
        "name": {
          "$ref": "#/$defs/source_properties/name"
        },
        "status": {
          "$ref": "#/$defs/source_properties/status"
        },
        "authority": {
          "$ref": "#/$defs/source_properties/authority"
        },
        "documentation_url": {
          "$ref": "#/$defs/source_properties/documentation_url"
        },
        "authentication": {
          "$ref": "#/$defs/source_properties/authentication"
        },
        "reuse_status": {
          "$ref": "#/$defs/source_properties/reuse_status"
        },
        "source_type": {
          "const": "derived"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dataset_id",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "dataset_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]+$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
