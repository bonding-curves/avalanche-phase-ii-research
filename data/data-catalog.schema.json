{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonding-curves/avalanche-phase-ii-research/data/data-catalog.schema.json",
  "title": "Avalanche research data catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "sources", "datasets"],
  "properties": {
    "$schema": {"const": "data-catalog.schema.json"},
    "schema_version": {"const": "avalanche-data-catalog/v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "source_type", "status", "authority", "documentation_url", "authentication", "reuse_status", "endpoints", "observed_site_cross_check"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "source_type": {"const": "rest_api"},
          "status": {"enum": ["declared", "implemented", "blocked", "stale"]},
          "authority": {"type": "string", "minLength": 1},
          "documentation_url": {"type": "string", "format": "uri"},
          "authentication": {"type": "string", "minLength": 1},
          "reuse_status": {"type": "string", "minLength": 1},
          "endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "url", "response_fields"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
                "url": {"type": "string", "format": "uri"},
                "response_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          },
          "observed_site_cross_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "stability", "relations"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "stability": {"type": "string", "minLength": 1},
              "relations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "source_id", "status", "description", "endpoint_ids", "fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
          "name": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["declared", "implemented", "blocked", "stale"]},
          "description": {"type": "string", "minLength": 1},
          "endpoint_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "unit", "derivation"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
                "type": {"enum": ["integer", "number", "timestamp", "string"]},
                "unit": {"type": "string", "minLength": 1},
                "derivation": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
