digraph fitted_lifecycle {
  graph [rankdir=LR, bgcolor="#ffffff", nodesep=0.3, ranksep=0.7, pad=0.3, fontname="DejaVu Sans", fontsize=14, newrank=true, compound=true];
  edge [fontname="DejaVu Sans", fontsize=11, fontcolor="#7a7f87"];
  subgraph cluster_inputs { label=<<B>Measured before the origin</B>>; fontname="DejaVu Sans"; color="#7a7f87"; style="rounded,dashed";
  "in:events" [label=<Staking events before the origin<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>renewal endings, return spells,<BR/>first-ever commitments, moves<BR/>and stake choices of the year<BR/>derived.staking-periods</FONT>>, shape=box, style="rounded,dashed,filled", color="#7a7f87", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  }
  subgraph cluster_fitted { label=<<B>Fitted on those events</B>>; fontname="DejaVu Sans"; color="#3566a3"; style=rounded;
  "block:renewal" [label=<Renewal: renew within seven days<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>RenewalLogit on tenure, after a return,<BR/>duration and stake; redrawn each run,<BR/>with a renewal shift</FONT>>, shape=box, style="rounded,filled", color="#3566a3", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "block:returns" [label=<Return: return after more than seven days<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>ReturnLogitHazard on days out, stake band,<BR/>returned before, first commitment;<BR/>redrawn each run</FONT>>, shape=box, style="rounded,filled", color="#3566a3", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "block:arrivals" [label=<Arrivals: first-ever nodes arrive<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>Arrivals, a negative binomial count;<BR/>redrawn each run</FONT>>, shape=box, style="rounded,filled", color="#3566a3", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "block:durations" [label=<Next duration<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>renewing or returning: the year's moves<BR/>with a like previous duration; new: the<BR/>year's first commitments; resampled each run</FONT>>, shape=box, style="rounded,filled", color="#b85c00", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "block:stake" [label=<Stake hurdle: stake of the next commitment<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>StakeChoice: keep the stake or change it,<BR/>by renewal, return or entry, stake<BR/>and duration; one point estimate</FONT>>, shape=box, style="rounded,filled", color="#237a57", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  }
  subgraph cluster_settings { label=<<B>Settings a run compares</B>>; fontname="DejaVu Sans"; color="#b84055"; style="rounded,dashed";
  "block:mechanism" [label=<Reward mechanism: Chain today<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>the design input, or<BR/>ACP-285 settings, Quadratic curve<BR/>Tenure boost</FONT>>, shape=box, style="rounded,filled", color="#b84055", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "block:responses" [label=<Yield-gap responses<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>swept, not fitted<BR/>renewal_response 0.0<BR/>entry_response 0.0<BR/>outside_yield_pp none<BR/>participation_elasticity 0.0</FONT>>, shape=box, style="rounded,dashed,filled", color="#b84055", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  }
  "step" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="2" CELLSPACING="7"><TR><TD BORDER="0"><B>Each day, in this order</B></TD></TR><TR><TD PORT="renewal" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>1. renewal</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>each commitment ending today renews on the<BR/>same node or leaves the set</FONT></TD></TR><TR><TD PORT="returns" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>2. returns</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>each node out of the set for<BR/>up to 365 days may come back</FONT></TD></TR><TR><TD PORT="arrivals" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>3. arrivals</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>how many nodes make<BR/>their first-ever commitment today</FONT></TD></TR><TR><TD PORT="continuation" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>4. continuation</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>each renewed, returned or new commitment<BR/>draws its duration, then its stake</FONT></TD></TR><TR><TD PORT="rewards" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>5. rewards</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>the reward mechanism prices each commitment<BR/>started today at today's supply</FONT></TD></TR><TR><TD PORT="assembly" STYLE="rounded" BGCOLOR="#f4f5f7" COLOR="#2b2b2b" CELLPADDING="7"><B>6. assembly</B><BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>open commitments that go on, then today's new<BR/>ones, then the scheduled ones due today</FONT></TD></TR></TABLE>>, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b"];
  subgraph cluster_state { label=<<B>State</B><BR/><FONT POINT-SIZE="10" COLOR="#7a7f87">from the chain at the origin, carried day to day</FONT>>; labelloc=b; fontname="DejaVu Sans"; color="#237a57"; style=rounded;
  "state:open" [label=<Open commitments<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>stake, days left, duration, tenure and record of each</FONT>>, shape=cylinder, style="solid,filled", color="#237a57", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "state:out" [label=<Nodes out of the set<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>up to 365 days; stake, days out, tenure and record of each</FONT>>, shape=cylinder, style="solid,filled", color="#237a57", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "state:supply" [label=<Reward counter<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>supply_navax, which the reward formula reads</FONT>>, shape=cylinder, style="solid,filled", color="#237a57", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "state:scheduled" [label=<Scheduled commitments<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>accepted by the origin, start later;<BR/>fixed, add no issuance in the run</FONT>>, shape=cylinder, style="solid,dashed,filled", color="#237a57", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  }
  subgraph cluster_out { label=<<B>Outputs</B>>; fontname="DejaVu Sans"; color="#7a7f87"; style=rounded;
  "out:daily" [label=<Daily table, a row per run and day<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>active_validators, active_validator_stake_navax<BR/>returning_nodes, supply_navax<BR/>issued_navax, started_stake_navax<BR/>nakamoto_third_nodes, yield_gap_pp<BR/>started_stake_days_navax, offered_rate_30d</FONT>>, shape=box, style="rounded,filled", color="#2b2b2b", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  "out:kpis" [label=<KPIs at 180 and 365 days<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>Issuance saved, Validator stake retained<BR/>Active validators, Net inflation<BR/>Validator staking ratio, Nakamoto coefficient<BR/>Return margin, Stake-weighted committed duration<BR/>Reward-rate volatility, Stake volatility<BR/>Issuance half-life</FONT>>, shape=box, style="rounded,filled", color="#2b2b2b", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  }
  "in:ledger" [label=<Monetary ledger to the origin<BR/><FONT POINT-SIZE='10' COLOR='#7a7f87'>measured before the origin: realized<BR/>supply, mean daily burn of the year<BR/>derived.avax-monetary-daily</FONT>>, shape=box, style="rounded,dashed,filled", color="#7a7f87", fillcolor="#ffffff", penwidth=2, fontname="DejaVu Sans", fontsize=13, fontcolor="#2b2b2b", margin="0.18,0.08"];
  { rank=same; "out:daily"; "out:kpis"; }
  "in:events" -> "block:arrivals" [lhead=cluster_fitted, color="#7a7f87", style=dashed, penwidth=1.6, arrowsize=0.7, label=" fit "];
  "block:renewal" -> "step":"renewal":w [color="#3566a3", penwidth=1.6, arrowsize=0.7, style=solid];
  "block:responses" -> "step":"renewal":w [color="#b84055", penwidth=1.6, arrowsize=0.7, style=dashed];
  "block:responses" -> "step":"arrivals":w [color="#b84055", penwidth=1.6, arrowsize=0.7, style=dashed];
  "block:returns" -> "step":"returns":w [color="#3566a3", penwidth=1.6, arrowsize=0.7, style=solid];
  "block:arrivals" -> "step":"arrivals":w [color="#3566a3", penwidth=1.6, arrowsize=0.7, style=solid];
  "block:durations" -> "step":"continuation":w [color="#3566a3", penwidth=1.6, arrowsize=0.7, style=solid];
  "step":"continuation":e -> "state:scheduled" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"assembly":e -> "state:scheduled" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "block:stake" -> "step":"continuation":w [color="#3566a3", penwidth=1.6, arrowsize=0.7, style=solid];
  "block:mechanism" -> "step":"rewards":w [color="#b84055", penwidth=1.6, arrowsize=0.7, style=solid];
  "step":"renewal":e -> "state:open" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"returns":e -> "state:out" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"arrivals":e -> "state:supply" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"continuation":e -> "state:open" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"continuation":e -> "state:out" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"continuation":e -> "state:supply" [color="#237a57", penwidth=1.4, arrowsize=0.7, style=dashed, dir=back];
  "step":"rewards":e -> "state:supply" [color="#237a57", penwidth=1.8, arrowsize=0.7, dir=both];
  "step":"assembly":e -> "state:open" [color="#237a57", penwidth=1.8, arrowsize=0.7, dir=both];
  "step":"assembly":e -> "state:out" [color="#237a57", penwidth=1.8, arrowsize=0.7, dir=both];
  "step":"rewards":e -> "out:daily" [color="#2b2b2b", penwidth=1.6, arrowsize=0.7];
  "step":"assembly":e -> "out:daily" [color="#2b2b2b", penwidth=1.6, arrowsize=0.7];
  "out:kpis" -> "out:daily" [color="#2b2b2b", penwidth=1.6, arrowsize=0.7, dir=back];
  "in:ledger" -> "out:kpis" [color="#7a7f87", penwidth=1.6, style=dashed, arrowsize=0.7];
}
